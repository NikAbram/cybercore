# Public canonical origin. Replace before deployment.
APP_ORIGIN=http://localhost:3000

# The form stays disabled until every readiness flag and server value is set.
BOOKING_FORM_ENABLED=false
BOOKING_PRIVACY_URL=https://example.com/privacy
BOOKING_RATE_LIMIT_CONFIGURED=false

# Resend server-only configuration. Never prefix these values with NEXT_PUBLIC_.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_EMAIL_TO=
